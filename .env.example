# Copy to backend/.env or export in your shell. All values are optional.
RATE_LIMIT_PER_MIN=30        # requests per IP per minute
MAX_IMAGE_MB=5               # screenshot upload limit
OCR_LANGS=eng+hin+tam        # Tesseract language packs to use (install them first)

# Optional AI explanation layer (off unless a key is set AND the user ticks the box)
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_TIMEOUT=20

# Learning loop (opt-in contributions are stored as masked fragments in a local SQLite file)
# LEARN_DB=backend/data/learn.db
# LEARN_MIN_SUPPORT=3          # reports needed before a phrase can become a candidate
# LEARN_RETENTION_DAYS=90      # contributions older than this are deleted
# ADMIN_TOKEN=                 # set to enable the reviewer endpoints; unset = locked
